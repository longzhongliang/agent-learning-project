# Copy this file to .env and replace the placeholder. Never commit .env.
DEEPSEEK_API_KEY=replace_with_your_rotated_key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_RETRIES=8

# Relative paths are resolved from the project root.
AGENT_WORKSPACE_DIR=./workspace
AGENT_DB_PATH=./data/agent.db
AGENT_RUN_TIMEOUT_SECONDS=20

# Optional: exposes filtered read-only GitHub/search MCP tools to the agent.
AGENT_ENABLE_MCP_TOOLS=false
